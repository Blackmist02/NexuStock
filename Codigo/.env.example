# Copiar a .env y ajustar valores
POSTGRES_DB=nexustock
POSTGRES_USER=nexustock
POSTGRES_PASSWORD=nexustock_dev
DB_PORT=5433
BACKEND_PORT=4000
# Puerto del frontend Next.js (el 3000 lo ocupa otro proyecto local)
FRONTEND_PORT=3001

# --- Autenticación (backend) ---
# Secreto para firmar las sesiones. En producción: mínimo 32 caracteres (openssl rand -hex 32)
# JWT_SECRET=
# URL del frontend (CORS y enlace del correo de recuperación)
# APP_URL=http://localhost:3001
# La primera cuenta creada es administrador y después "Crear cuenta" se cierra: el equipo se crea en Configuración.
# Con true, "Crear cuenta" sigue abierto (rol operador).
# ALLOW_PUBLIC_SIGNUP=false
# Correo de recuperación: sin SMTP_URL el enlace se imprime en el log del backend (docker compose logs backend)
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com

# --- Motor predictivo (opcional; ver ml-engine/README.md) ---
# Sin Python o sin modelo activo, el sistema usa el promedio histórico.
# WITH_PYTHON=true
# ML_PIP_PACKAGES=scikit-learn joblib pandas
# ML_TIMEOUT_MS=2000
# CAPACIDAD_KG_SEMANA=5000
# Cada cuántos minutos se recalculan predicciones y alertas (0 = solo al registrar ventas/compras)
# EVALUACION_CADA_MIN=60
