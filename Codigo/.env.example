# Copiar a .env y ajustar valores
POSTGRES_DB=nexustock
POSTGRES_USER=nexustock
POSTGRES_PASSWORD=nexustock_dev
DB_PORT=5433
BACKEND_PORT=4000
# Puerto del frontend Next.js (el 3000 lo ocupa otro proyecto local)
FRONTEND_PORT=3001

# --- Autenticación (backend) ---
# Secreto para firmar las sesiones. En producción: mínimo 32 caracteres (openssl rand -hex 32)
# JWT_SECRET=
# URL del frontend (CORS y enlace del correo de recuperación)
# APP_URL=http://localhost:3001
# La primera cuenta creada es administrador. Con true, "Crear cuenta" sigue abierto para el equipo (rol operador);
# ponlo en false cuando todas las cuentas del equipo ya existan.
# ALLOW_PUBLIC_SIGNUP=true
# Correo de recuperación: sin SMTP_URL el enlace se imprime en el log del backend (docker compose logs backend)
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com
