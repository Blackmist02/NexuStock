# Copiar a .env y ajustar valores
POSTGRES_DB=nexustock
POSTGRES_USER=nexustock
POSTGRES_PASSWORD=nexustock_dev
DB_PORT=5433
BACKEND_PORT=4000
# Puerto del frontend Next.js (el 3000 lo ocupa otro proyecto local)
FRONTEND_PORT=3001

# --- Autenticación (backend) ---
# Secreto para firmar las sesiones. En producción: mínimo 32 caracteres (openssl rand -hex 32)
# JWT_SECRET=
# URL del frontend (CORS y enlace del correo de recuperación)
# APP_URL=http://localhost:3001
# La primera cuenta creada es administrador. Con true, "Crear cuenta" sigue abierto para el equipo (rol operador);
# ponlo en false cuando todas las cuentas del equipo ya existan.
# ALLOW_PUBLIC_SIGNUP=true
# Correo de recuperación: sin SMTP_URL el enlace se imprime en el log del backend (docker compose logs backend)
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com

# --- Demostración con datos históricos ---
# Fecha que el sistema usa como «hoy» (AAAA-MM-DD). Debe coincidir con ml-engine/cargar_bd.py --hasta.
# Conviene que sea domingo: el modelo predice la semana que empieza el lunes siguiente. Vacío = fecha real.
# FECHA_REFERENCIA=2024-03-31

# --- Motor de ML (PyPredictorAdapter) ---
# El backend lanza «predict.py --servidor» al iniciar. Si el script no existe, usa el respaldo por promedio.
# ML_HABILITADO=true
# ML_PYTHON=python3
# ML_SCRIPT=/ruta/a/ml-engine/predict.py
# Tiempo máximo por solicitud antes de usar el respaldo (RNF: 2,0 s)
# ML_TIMEOUT_MS=2000

# --- Base de datos en la nube (Supabase, etapa 1) ---
# URL del Session pooler (Connect → Direct → Session pooler, puerto 5432). La usan los scripts de ml-engine
# (crear_esquema.py y cargar_bd.py con --env-url SUPABASE_DB_URL).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Para que el backend use Supabase en vez del PostgreSQL local, define también:
# BACKEND_DATABASE_URL='<la misma URL de SUPABASE_DB_URL>'   (entre comillas simples: Docker Compose
#   interpreta el carácter $ de la clave como variable si no van)
# DB_SSL=verificado
# DB_SSL_CA=/certs/prod-ca-2021.crt   # CA pública de Supabase (Codigo/certs/, montada en el contenedor)
# (DB_SSL=requerido cifra sin verificar el servidor: solo para pruebas)
