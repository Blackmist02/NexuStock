# =====================================================================
# NexuStock — archivos y carpetas que NO se suben al repositorio
# =====================================================================

# --- Dependencias (se reinstalan con npm install / npm ci) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Builds y caché (Next.js / Node) ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel
.turbo/
.cache/
.eslintcache

# --- Tests ---
coverage/
.nyc_output/

# --- Variables de entorno (contraseñas y secretos) ---
# Solo se sube la plantilla .env.example
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Certificados / llaves ---
*.pem
*.key

# --- Modelos de ML entrenados (artefactos pesados, se regeneran) ---
*.pkl
*.joblib
__pycache__/
*.pyc
.venv/
venv/

# --- Editores / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- Sistema operativo / OneDrive ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Archivos temporales de Office (documentos abiertos) ---
~$*
*.tmp
